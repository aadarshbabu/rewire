version = 0.1

[default.global.parameters]
stack_name = "rewire-ai-stack"

[default.build.parameters]
cached = true
parallel = true

[default.deploy.parameters]
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
resolve_s3 = true
s3_prefix = "rewire-ai-worker"
region = "us-east-1"
parameter_overrides = [
  "Environment=\"production\"",
  "DatabaseUrl=\"postgresql://user:password@host:5432/dbname?sslmode=require\"",
  "RedisUrl=\"rediss://default:password@host:6379\"",
  "MistralApiKey=\"your-mistral-api-key\"",
  "Neo4jUri=\"neo4j+s://your-instance.databases.neo4j.io\"",
  "Neo4jPassword=\"your-neo4j-password\"",
  "MaxWorkerConcurrency=20"
]
