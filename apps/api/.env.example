# Database (PostgreSQL)
DATABASE_URL="postgres://user:password@localhost:5432/rewire?sslmode=disable"

# Redis
REDIS_URL="redis://localhost:6379"

# Neo4j (GraphRAG Knowledge Graph)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password"

# Mistral AI LLM
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=open-mistral-7b

# AWS SQS Asynchronous Queue
AWS_SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/test-test/rewire-queue
AWS_REGION=ap-south-1
ENABLE_LOCAL_SQS_POLLER=true

# LangSmith Tracing & Observability
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_key
LANGSMITH_PROJECT=rewire
