# ==========================================
# Rewire API - Production Environment Template
# Copy this file to .env.production and provide real production credentials
# ==========================================
NODE_ENV=production
PORT=4000

# Database (PostgreSQL - e.g. Aiven / AWS RDS)
DATABASE_URL="postgres://user:password@production-db-host:5432/rewire?sslmode=require"

# Redis (Production Cluster / Upstash / AWS ElastiCache / Aiven Redis)
REDIS_URL="rediss://default:password@production-redis-host:6379"

# Neo4j Graph Database (Neo4j AuraDB / Production Instance)
# For AuraDB use: neo4j+s://<dbid>.databases.neo4j.io
NEO4J_URI="neo4j+s://<instance-id>.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your-production-neo4j-password"

# Mistral AI LLM (Production API Key)
MISTRAL_API_KEY=your-production-mistral-api-key
# Choices: mistral-large-latest, mistral-small-latest, codestral-latest, open-mistral-7b
MISTRAL_MODEL=mistral-large-latest

# AWS SQS Asynchronous Queue & Credentials
AWS_SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/rewire-queue-prod
AWS_REGION=ap-south-1
# Set AWS credentials if not using IAM Roles/ECS task execution roles:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# SQS Polling Worker
# Set to 'true' if running as a standalone container/worker server.
# Set to 'false' if processing via AWS Lambda trigger.
ENABLE_LOCAL_SQS_POLLER=true

# LangSmith Tracing & Observability
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_production_langsmith_key
LANGSMITH_PROJECT=rewire-prod
